{
  "name": "agent-cowork-host-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Kimi-only local cowork host MVP scaffold",
  "scripts": {
    "start": "node scripts/run-host-node.mjs apps/host/src/main.ts",
    "start:mvp": "node scripts/run-host-node.mjs scripts/start-mvp.ts",
    "status:mvp": "node scripts/run-host-node.mjs scripts/status-mvp.ts",
    "stop:mvp": "node scripts/run-host-node.mjs scripts/stop-mvp.ts",
    "demo:mvp": "node scripts/run-host-node.mjs scripts/demo-mvp.ts",
    "start:tauri-host": "node scripts/run-host-node.mjs scripts/start-tauri-host.ts",
    "audit:mvp": "node scripts/run-host-node.mjs scripts/audit-mvp.ts",
    "verify:mvp": "node scripts/run-host-node.mjs scripts/verify-mvp.ts",
    "verify:windows-readiness": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows-client-readiness.ps1",
    "smoke:host": "node scripts/run-host-node.mjs scripts/smoke-local-operations.ts",
    "smoke:live-mvp": "node scripts/run-host-node.mjs scripts/smoke-live-mvp.ts",
    "smoke:plan-loop": "node scripts/run-host-node.mjs scripts/smoke-plan-closed-loop.ts",
    "smoke:mvp-runtime": "node scripts/run-host-node.mjs scripts/smoke-mvp-runtime.ts",
    "smoke:kimi-api": "node scripts/run-host-node.mjs scripts/smoke-kimi-api.ts",
    "smoke:tauri-scaffold": "node scripts/run-host-node.mjs scripts/smoke-tauri-scaffold.ts",
    "smoke:rendered-ui": "node scripts/run-host-node.mjs scripts/smoke-rendered-ui.ts",
    "smoke:react-scroll": "node scripts/run-host-node.mjs scripts/smoke-react-scroll.ts",
    "smoke:react-artifacts": "node scripts/run-host-node.mjs scripts/smoke-react-artifacts-panel.ts",
    "smoke:react-live-artifact": "node scripts/run-host-node.mjs scripts/smoke-react-live-artifact.ts",
    "smoke:react-branches": "node scripts/run-host-node.mjs scripts/smoke-react-branches.ts",
    "smoke:react-connectors": "node scripts/run-host-node.mjs scripts/smoke-react-connectors.ts",
    "smoke:react-connectors:live-github": "node scripts/run-host-node.mjs scripts/smoke-react-connectors.ts --live-github",
    "smoke:windows-resources": "node scripts/run-host-node.mjs scripts/smoke-windows-client-resources.ts",
    "smoke:windows-paths": "node scripts/run-host-node.mjs scripts/smoke-windows-paths.ts",
    "smoke:sqlite-runtime": "node scripts/run-host-node.mjs scripts/smoke-sqlite-runtime.ts",
    "smoke:runtime-update": "node scripts/run-host-node.mjs scripts/smoke-runtime-update-preservation.ts",
    "smoke:offline-local": "node scripts/run-host-node.mjs scripts/smoke-offline-local.ts",
    "smoke:e2e": "node scripts/run-host-node.mjs scripts/e2e-smoke.ts",
    "bench": "node scripts/run-host-node.mjs scripts/bench.ts",
    "eval": "node scripts/run-host-node.mjs scripts/eval.ts",
    "smoke:windows-client": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows-client.ps1",
    "smoke:installed-tauri": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-installed-tauri.ps1",
    "smoke:ui": "node scripts/run-host-node.mjs scripts/smoke-ui-contract.ts",
    "prepare:embedded-python": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-embedded-python.ps1",
    "check:arch": "node scripts/run-host-node.mjs scripts/check-arch.ts",
    "check:filesize": "node scripts/run-host-node.mjs scripts/check-filesize.ts",
    "check:secrets": "node scripts/run-host-node.mjs scripts/check-secrets.ts",
    "check:host-types": "node scripts/run-host-node.mjs scripts/check-host-types.ts",
    "check:eval-types": "npx tsc -p tsconfig.eval.json --pretty false",
    "check:host-test-types": "npx tsc -p tsconfig.host-test.json --pretty false",
    "check:root-types": "npx tsc -p tsconfig.json --pretty false",
    "check:script-types": "npx tsc -p tsconfig.scripts.json --pretty false",
    "check:resource-types": "npx tsc -p tsconfig.windows-resources.json --noEmit --pretty false",
    "check:ui-types": "npm --prefix apps/windows-client/ui run typecheck",
    "lint:ts": "eslint \"eslint.config.ts\" \"apps/host/*.ts\" \"apps/host/mcp-servers/**/*.ts\" \"apps/host/scripts/**/*.ts\" \"apps/host/src/**/*.ts\" \"apps/host/test/**/*.ts\" \"eval/**/*.ts\" \"scripts/**/*.ts\" \"apps/windows-client/resources-src/**/*.ts\" \"apps/windows-client/ui/src/**/*.{ts,tsx}\" \"apps/windows-client/ui/*.ts\"",
    "lint:resources-js": "eslint \"apps/windows-client/resources/*.js\"",
    "check:lint": "npm run lint:ts && npm run lint:resources-js",
    "check:resource-js": "node scripts/run-host-node.mjs scripts/check-resource-js.ts",
    "check:js-boundary": "node scripts/run-host-node.mjs scripts/check-js-boundary.ts",
    "check:icons": "node scripts/run-host-node.mjs scripts/check-icons.ts",
    "check": "npm run check:arch && npm run check:filesize && npm run check:secrets && npm run check:host-types && npm run check:eval-types && npm run check:host-test-types && npm run check:root-types && npm run check:script-types && npm run check:resource-types && npm run check:ui-types && npm run check:lint && npm run check:resource-js && npm run check:js-boundary && npm run check:icons",
    "ci": "node scripts/run-host-node.mjs scripts/ci.ts",
    "release": "node scripts/run-host-node.mjs scripts/release.ts",
    "test": "npm run test:host && npm run test:ui",
    "test:isolated": "node scripts/run-host-node.mjs --cwd apps/host -- --test",
    "build:ui": "node scripts/run-host-node.mjs scripts/build-ui.ts",
    "build:ui:fresh": "node scripts/run-host-node.mjs scripts/build-ui.ts --install",
    "build:host-source": "node scripts/run-host-node.mjs scripts/build-host-source.ts",
    "build:host": "node scripts/run-host-node.mjs scripts/build-host.ts",
    "test:host": "npm run check && node scripts/run-host-node.mjs --cwd apps/host -- --test --test-isolation=process --test-timeout=60000 --import ../../scripts/test-setup.ts \"test/*.test.js\" \"test/*.test.ts\"",
    "test:ui": "npm --prefix apps/windows-client/ui run test",
    "build:resources": "npx tsc -p tsconfig.windows-resources.json --pretty false"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.60.0"
  }
}
