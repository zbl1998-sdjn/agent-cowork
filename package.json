{
  "name": "agent-cowork-host-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Kimi-only local cowork host MVP scaffold",
  "scripts": {
    "start": "node scripts/run-host-node.mjs apps/host/src/main.ts",
    "start:mvp": "node scripts/run-host-node.mjs scripts/start-mvp.mjs",
    "status:mvp": "node scripts/status-mvp.mjs",
    "stop:mvp": "node scripts/stop-mvp.mjs",
    "demo:mvp": "node scripts/demo-mvp.mjs",
    "start:tauri-host": "node scripts/run-host-node.mjs scripts/start-tauri-host.mjs",
    "audit:mvp": "node scripts/audit-mvp.mjs",
    "verify:mvp": "node scripts/verify-mvp.mjs",
    "verify:windows-readiness": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows-client-readiness.ps1",
    "smoke:host": "node scripts/run-host-node.mjs scripts/smoke-local-operations.mjs",
    "smoke:live-mvp": "node scripts/smoke-live-mvp.mjs",
    "smoke:plan-loop": "node scripts/run-host-node.mjs scripts/smoke-plan-closed-loop.mjs",
    "smoke:mvp-runtime": "node scripts/smoke-mvp-runtime.mjs",
    "smoke:kimi-api": "node scripts/run-host-node.mjs scripts/smoke-kimi-api.mjs",
    "smoke:tauri-scaffold": "node scripts/smoke-tauri-scaffold.mjs",
    "smoke:rendered-ui": "node scripts/run-host-node.mjs scripts/smoke-rendered-ui.mjs",
    "smoke:react-scroll": "node scripts/run-host-node.mjs scripts/smoke-react-scroll.mjs",
    "smoke:react-artifacts": "node scripts/run-host-node.mjs scripts/smoke-react-artifacts-panel.mjs",
    "smoke:react-live-artifact": "node scripts/run-host-node.mjs scripts/smoke-react-live-artifact.mjs",
    "smoke:react-branches": "node scripts/run-host-node.mjs scripts/smoke-react-branches.mjs",
    "smoke:react-connectors": "node scripts/run-host-node.mjs scripts/smoke-react-connectors.mjs",
    "smoke:react-connectors:live-github": "node scripts/run-host-node.mjs scripts/smoke-react-connectors.mjs --live-github",
    "smoke:windows-resources": "node scripts/smoke-windows-client-resources.mjs",
    "smoke:windows-paths": "node scripts/run-host-node.mjs scripts/smoke-windows-paths.mjs",
    "smoke:sqlite-runtime": "node scripts/run-host-node.mjs scripts/smoke-sqlite-runtime.mjs",
    "smoke:runtime-update": "node scripts/run-host-node.mjs scripts/smoke-runtime-update-preservation.mjs",
    "smoke:offline-local": "node scripts/run-host-node.mjs scripts/smoke-offline-local.mjs",
    "smoke:e2e": "node scripts/run-host-node.mjs scripts/e2e-smoke.mjs",
    "bench": "node scripts/run-host-node.mjs scripts/bench.mjs",
    "eval": "node scripts/run-host-node.mjs scripts/eval.mjs",
    "smoke:windows-client": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows-client.ps1",
    "smoke:installed-tauri": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-installed-tauri.ps1",
    "smoke:ui": "node scripts/run-host-node.mjs scripts/smoke-ui-contract.mjs",
    "prepare:embedded-python": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-embedded-python.ps1",
    "check:arch": "node scripts/check-arch.mjs",
    "check:filesize": "node scripts/check-filesize.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:host-types": "node scripts/check-host-types.mjs",
    "check:eval-types": "npx tsc -p tsconfig.eval.json --pretty false",
    "check:host-test-types": "npx tsc -p tsconfig.host-test.json --pretty false",
    "check:ui-types": "npm --prefix apps/windows-client/ui run typecheck",
    "lint:ts": "eslint \"apps/host/src/**/*.ts\" \"apps/host/test/**/*.ts\" \"eval/**/*.ts\" \"apps/windows-client/ui/src/**/*.{ts,tsx}\" \"apps/windows-client/ui/vite.config.ts\"",
    "check:lint": "npm run lint:ts",
    "check:resource-js": "node scripts/check-resource-js.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check": "npm run check:arch && npm run check:filesize && npm run check:secrets && npm run check:host-types && npm run check:eval-types && npm run check:host-test-types && npm run check:ui-types && npm run check:lint && npm run check:resource-js && npm run check:icons",
    "ci": "node scripts/ci.mjs",
    "release": "node scripts/release.mjs",
    "test": "npm run test:host && npm run test:ui",
    "test:isolated": "node scripts/run-host-node.mjs --cwd apps/host -- --test",
    "build:ui": "node scripts/build-ui.mjs",
    "build:ui:fresh": "node scripts/build-ui.mjs --install",
    "build:host-source": "node scripts/build-host-source.mjs",
    "build:host": "node scripts/build-host.mjs",
    "test:host": "npm run check && node scripts/run-host-node.mjs --cwd apps/host -- --test --test-isolation=process --test-timeout=60000 --import ../../test-setup.mjs \"test/*.test.js\" \"test/*.test.ts\"",
    "test:ui": "npm --prefix apps/windows-client/ui run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.60.0"
  }
}
