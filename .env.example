# Agent Cowork local/interview configuration template.
# Copy this file to `.env` (gitignored) and fill only the values you actually need.
# Keep real API keys out of commits. Placeholder values intentionally use dummy/sample words
# so `npm run check:secrets` can distinguish examples from leaked credentials.

# ---------------------------------------------------------------------------
# 0. Interview demo defaults
# ---------------------------------------------------------------------------
# Web/MVP demo entry:
#   npm run demo:mvp
#   npm run start:mvp
# Desktop sidecar entry:
#   npm run start:tauri-host
#
# Keep HOST on loopback for normal demos. Binding 0.0.0.0 exposes the local
# file/tool API to the network and should be treated as a separate deployment task.
HOST=127.0.0.1
# Tauri sidecar uses 3017. Plain `npm start` falls back to 3001 when PORT is absent.
PORT=3017
# The host may only read/write under this root. Leave empty to use the current directory.
# TRUSTED_ROOT=C:\Users\Administrator\Desktop\agent cowork

# Security posture:
#   local_strict      local/offline first; external network tools are blocked and high-risk
#                     execution requires a network-isolated Docker/VM sandbox.
#   enterprise_hybrid local/customer gateway allowed; external model providers are blocked.
#   saas_opt_in       external providers are allowed only as an explicit SaaS/online posture.
SECURITY_MODE=saas_opt_in
# KCW_SECURITY_MODE=local_strict
# KCW_CUSTOMER_MODEL_GATEWAY_HOSTS=llm-gateway.corp,models.example.internal

# ---------------------------------------------------------------------------
# 1. Model provider: Kimi/Moonshot compatible API
# ---------------------------------------------------------------------------
# For an offline interview demo, keep KIMI_API_KEY empty. Local file operations,
# plan previews, approvals, UI smoke tests, and most gates still work.
# For a live model demo, set KIMI_API_KEY or MOONSHOT_API_KEY in your private `.env`.
KIMI_API_KEY=
# MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.7-code
KIMI_API_TIMEOUT_MS=60000
KIMI_API_MAX_TOKENS=2048
# Optional request metadata/tuning. Leave unset unless the upstream provider asks for it.
# KIMI_USER_AGENT=agent-cowork-interview-demo
# KIMI_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# 2. Optional alternate provider: Anthropic-compatible fallback path
# ---------------------------------------------------------------------------
# The host normalizes provider/key/url/model in apps/host/src/kimi/api-runner-config.ts.
# Only enable this section when you are deliberately demonstrating provider switching.
# KCW_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=dummy_anthropic_api_key_for_local_demo
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-demo
#
# JSON fallback chain used by the model runner. Keep it one line in `.env`.
# KCW_MODEL_FALLBACKS=[{"provider":"kimi-api","model":"kimi-k2.7-code"},{"provider":"anthropic","model":"claude-sonnet-demo"}]

# ---------------------------------------------------------------------------
# 2b. Optional opencode-style provider_id/model_id presets
# ---------------------------------------------------------------------------
# Model selection follows opencode desktop's catalog-first shape:
#   provider_id/model_id
# Built-in OpenAI-compatible provider ids include:
#   kimi-api, deepseek, qwen-dashscope-cn, zai-glm, volcengine-ark,
#   baidu-qianfan, tencent-hunyuan, minimax, iflytek-spark,
#   siliconflow-cn, openai/local, lmstudio, custom-openai-compatible.
# Example:
# KCW_MODEL_PROVIDER=deepseek
# KIMI_MODEL=deepseek-v4-flash
# Or one full id when provider is omitted:
# KIMI_MODEL=deepseek/deepseek-v4-flash
# DEEPSEEK_API_KEY=dummy_deepseek_api_key_for_local_demo
# DASHSCOPE_API_KEY=dummy_dashscope_api_key_for_local_demo
# ZAI_API_KEY=dummy_zai_api_key_for_local_demo
# ARK_API_KEY=dummy_ark_api_key_for_local_demo
# QIANFAN_API_KEY=dummy_qianfan_api_key_for_local_demo
# HUNYUAN_API_KEY=dummy_hunyuan_api_key_for_local_demo
# MINIMAX_API_KEY=dummy_minimax_api_key_for_local_demo
# SPARK_API_KEY=dummy_spark_api_key_for_local_demo
# SILICONFLOW_API_KEY=dummy_siliconflow_api_key_for_local_demo
# Local OpenAI-compatible services do not require an API key:
# KCW_MODEL_PROVIDER=openai/local
# KIMI_BASE_URL=http://127.0.0.1:11434/v1
# KIMI_MODEL=qwen2.5-coder:7b

# ---------------------------------------------------------------------------
# 2c. Automatic history compaction (context window aware)
# ---------------------------------------------------------------------------
# The agent auto-compacts chat history before each model call. When the request
# does not pin an explicit maxContextTokens, the threshold adapts to the selected
# model's context window (see apps/host/src/kimi/context/model-context-window.ts),
# using this input ratio to leave headroom for the model's output. Unknown models
# fall back to the compactor's conservative built-in default. Range 0.1-1.0.
# KCW_CONTEXT_INPUT_RATIO=0.75
#
# Local / BYO gateways (openai/local Ollama, lmstudio, custom-openai-compatible) do
# NOT get a guessed context window from the model name, because one local endpoint can
# serve any model at any num_ctx and over-guessing risks context overflow. Declare the
# real window in tokens here (e.g. an Ollama model started with a 8192 num_ctx). This
# also overrides the built-in window for cloud providers when set.
# KCW_MODEL_CONTEXT_WINDOW=8192

# ---------------------------------------------------------------------------
# 3. Auth and request boundary
# ---------------------------------------------------------------------------
# Require a valid local session/JWT on every /api route. Keep true for anything
# beyond isolated tests; tests set their own environment in scripts/test-setup.ts.
KCW_REQUIRE_AUTH=true
# Only set a JWT secret for stateless multi-instance demos. Empty means local opaque sessions.
KCW_JWT_SECRET=
# Do not trust x-tenant-id/x-user-id from clients unless a trusted reverse proxy strips
# attacker-supplied identity headers before requests reach the host.
KCW_TRUST_IDENTITY_HEADERS=false
# Host header validation blocks DNS-rebinding style access. Keep true for local demos.
KCW_VALIDATE_HOST=true
# Persist login/session state to `.AgentCowork/auth.sqlite`. Set false only for tests.
KCW_AUTH_PERSIST=true
# KCW_AUTH_DB=C:\Users\Administrator\AppData\Roaming\AgentCowork\auth.sqlite

# ---------------------------------------------------------------------------
# 4. Storage backend
# ---------------------------------------------------------------------------
# file: simplest local demo; sqlite: single-file durable local state; postgres: multi-instance demo.
KCW_STORE=file
# KCW_STORE=sqlite
# KCW_SQLITE_PATH=C:\Users\Administrator\AppData\Roaming\AgentCowork\state.sqlite
#
# Postgres requires applying apps/host/src/storage/migrations-postgres/0001_init.sql first.
# DATABASE_URL=postgres://agent_cowork:sample_password@127.0.0.1:5432/agent_cowork
# PGPOOL_MAX=20

# ---------------------------------------------------------------------------
# 5. Sandbox and local runtimes
# ---------------------------------------------------------------------------
# auto: prefer Docker with a configured local image; otherwise fall back to local subprocess
# and report that network isolation is not guaranteed.
KCW_SANDBOX_BACKEND=auto
# KCW_SANDBOX_DOCKER_IMAGE=agent-cowork-sandbox:local
# Used only by the real Docker network-isolation smoke:
# KCW_SANDBOX_REAL_DOCKER_IMAGE=postgres:16-alpine
#
# Bundled/portable runtime overrides. These are useful for installed-build demos.
# KCW_NODE_EXE=C:\Tools\node\node.exe
# KCW_NODE_HOME=C:\Tools\node
# KCW_EMBEDDED_PYTHON=C:\Tools\python\python.exe
# KCW_PYTHON_HOME=C:\Tools\python
# KCW_MINGIT_HOME=C:\Tools\mingit
# KCW_CHROMIUM_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# KCW_PLAYWRIGHT_CHROMIUM_HOME=C:\Users\Administrator\AppData\Local\ms-playwright
# KCW_WEBVIEW2_MODE=runtime
# KCW_VC_RUNTIME_INSTALLED=1
# KCW_CJK_FONT=C:\Windows\Fonts\msyh.ttc
# KCW_PANDOC_EXE=C:\Tools\pandoc\pandoc.exe
# KCW_TESSERACT_HOME=C:\Tools\tesseract
# KCW_DATA_SCIENCE_HOME=C:\Tools\data-science

# ---------------------------------------------------------------------------
# 6. Rate limits, concurrency, and logs
# ---------------------------------------------------------------------------
KCW_RATE_PER_SEC=50
KCW_RATE_BURST=100
KCW_MAX_CONCURRENT_RUNS=64
KCW_MAX_RUNS_PER_TENANT=8
KCW_LOG_MAX_BYTES=8388608
KCW_LOG_MAX_FILES=3

# ---------------------------------------------------------------------------
# 7. Credentials and connectors
# ---------------------------------------------------------------------------
# App home stores sessions, credentials, and other host-owned state. The Windows
# default is `%APPDATA%\AgentCowork`; override only for portable or test installs.
# AGENT_COWORK_HOME=C:\Users\Administrator\AppData\Roaming\AgentCowork
#
# Credential store secrets are encrypted with DPAPI on Windows when available. KCW_CREDENTIAL_KEY
# is only for non-Windows or deterministic test/demo stores; do not commit a real value.
# KCW_CREDENTIAL_STORE=C:\Users\Administrator\AppData\Roaming\AgentCowork\credentials.json
# KCW_CREDENTIAL_KEY=sample_credential_key_min_32_chars_for_demo
#
# GitHub connector uses OAuth device flow. It needs a public client id, not a client secret.
# KCW_GITHUB_OAUTH_CLIENT_ID=sample_github_oauth_client_id

# ---------------------------------------------------------------------------
# 8. Optional report/output locations for smoke scripts
# ---------------------------------------------------------------------------
# These are useful when you want interview evidence in a separate folder.
# MVP_RUNTIME_FILE=build/mvp-runtime.json
# REACT_CONNECTORS_REPORT_DIR=reports/react-connectors
# REACT_SCROLL_REPORT_DIR=reports/react-scroll
# REACT_ARTIFACTS_REPORT_DIR=reports/react-artifacts
# PLAN_LOOP_REPORT_DIR=reports/plan-closed-loop
# WINDOWS_PATHS_REPORT_DIR=reports/windows-paths

# ---------------------------------------------------------------------------
# 9. Optional long-term memory backend (MASE MCP)
# ---------------------------------------------------------------------------
# When enabled, the host auto-connects a MASE memory MCP server on startup and uses it
# as an automatic memory backend: each turn recalls relevant history/facts into context
# and writes the user+assistant turn back (see apps/host/src/memory/mase-bridge.ts).
# Disabled by default; when unset the whole bridge is a no-op and built-in file memory is used.
#
# Safety boundaries already enforced by the bridge:
#   - Credential/secret-bearing content is classified (security/data-classifier) and skipped
#     before any write leaves the machine (same DLP guard as built-in memory).
#   - Recall and write-back both respect the workspace memory switch (pause/incognito/disabled
#     in .AgentCowork/memory-settings.json), so the UI toggle really stops live memory.
#
# Enable both of the next two to turn it on:
# MASE_MCP_ENABLED=1
# MASE_REPO=C:\Path\To\mase-repo
# Optional overrides (defaults derive from MASE_REPO):
# MASE_CONFIG_PATH=C:\Path\To\mase-repo\config.json
# Point memory storage at a writable dir (avoids sandbox-read-only drives):
# MASE_MEMORY_DIR=C:\Users\Administrator\AppData\Roaming\AgentCowork\mase-memory
